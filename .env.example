# Supabase (client — safe to expose with EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel chat API (client — your deployed Vercel URL, no trailing slash)
EXPO_PUBLIC_CHAT_API_URL=https://your-app.vercel.app

# Groq (server-only — set in Vercel dashboard, NOT in the app)
GROQ_API_KEY=your-groq-api-key
